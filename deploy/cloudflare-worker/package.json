{
  "name": "klms-sync-cloudflare-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check src/worker.mjs",
    "test": "node --test test/setup-script.test.mjs && node test/smoke.mjs",
    "test:integration": "node test/integration.mjs",
    "setup": "zsh ./setup_cloudflare_relay.sh",
    "dev": "wrangler --config wrangler.local.toml dev",
    "deploy": "wrangler --config wrangler.local.toml deploy",
    "d1:create": "wrangler d1 create klms-sync-relay",
    "d1:migrate:local": "wrangler --config wrangler.local.toml d1 migrations apply klms-sync-relay --local",
    "d1:migrate": "wrangler --config wrangler.local.toml d1 migrations apply klms-sync-relay --remote"
  },
  "devDependencies": {
    "wrangler": "^4.113.0"
  },
  "overrides": {
    "sharp": "0.35.3"
  }
}
