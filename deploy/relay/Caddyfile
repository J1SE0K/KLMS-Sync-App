(relay_proxy) {
	reverse_proxy relay:18484 {
		header_up X-KLMS-Relay-Client-IP {remote_host}
		header_up X-KLMS-Relay-Proxy-Secret {$KLMS_RELAY_TRUSTED_PROXY_SECRET}
	}
}

{$KLMS_RELAY_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	handle /healthz {
		import relay_proxy
	}

	handle /readyz {
		import relay_proxy
	}

	handle_path /relay/* {
		import relay_proxy
	}

	handle {
		import relay_proxy
	}
}
