{
  "schemaVersion": 1,
  "scoreModel": {
    "areas": {
      "functionAndDataIntegrity": 20,
      "responsiveUI": 20,
      "uxAndAccessibility": 15,
      "webSocketLatencyAndPerformance": 15,
      "securityAndPrivacy": 15,
      "reliabilityAndRecovery": 10,
      "testAndReleaseReadiness": 5
    },
    "caps": {
      "openP0": 39,
      "openP1": 79,
      "openP2": 89,
      "missingMandatoryExternalEvidence": 94
    }
  },
  "candidateBinding": {
    "cleanWorktreeRequired": true,
    "fullCommitSHARequired": true,
    "appPayloadManifest": "Contents/Resources/EnginePayload/EnginePayloadManifest.json",
    "reviewEvidenceExpiresOnSourceChange": true
  },
  "automatedGates": [
    {
      "id": "python-core",
      "command": "PYTHONPATH=vendor/python-packages python3 -B -m unittest discover -s tests",
      "execution": {
        "workingDirectory": ".",
        "environment": {"PYTHONPATH": "vendor/python-packages"},
        "timeoutSeconds": 1800,
        "maxOutputBytes": 67108864,
        "steps": [
          {"argv": ["python3", "-B", "-m", "unittest", "discover", "-s", "tests"]}
        ]
      }
    },
    {
      "id": "swift-clients",
      "command": "swift test --enable-xctest --disable-swift-testing --package-path apps/KLMSync --scratch-path <isolated-path> --jobs 1",
      "execution": {
        "workingDirectory": ".",
        "environment": {},
        "timeoutSeconds": 1800,
        "maxOutputBytes": 67108864,
        "steps": [
          {"argv": ["swift", "test", "--enable-xctest", "--disable-swift-testing", "--package-path", "apps/KLMSync", "--scratch-path", "<isolated-path>", "--jobs", "1"]}
        ]
      }
    },
    {
      "id": "mac-runtime",
      "command": "KLMS_READINESS_REQUIRE_CLEAN=1 KLMS_PAYLOAD_REQUIRE_CLEAN=1 KLMS_READINESS_SWIFT_TESTS=0 KLMS_READINESS_IOS_BUILD=0 KLMS_READINESS_IOS_LAUNCH=0 KLMS_MAC_AX_SAFE_FIXTURE=1 KLMS_MAC_AX_SCREENSHOT_DIR=<isolated-path> tools/verify_klms_app_readiness.sh",
      "execution": {
        "workingDirectory": ".",
        "environment": {
          "KLMS_READINESS_REQUIRE_CLEAN": "1",
          "KLMS_PAYLOAD_REQUIRE_CLEAN": "1",
          "KLMS_READINESS_SWIFT_TESTS": "0",
          "KLMS_READINESS_IOS_BUILD": "0",
          "KLMS_READINESS_IOS_LAUNCH": "0",
          "KLMS_MAC_AX_SAFE_FIXTURE": "1",
          "KLMS_MAC_AX_SCREENSHOT_DIR": "<isolated-path>"
        },
        "timeoutSeconds": 1800,
        "maxOutputBytes": 67108864,
        "steps": [
          {"argv": ["tools/verify_klms_app_readiness.sh"]}
        ]
      }
    },
    {
      "id": "mac-isolated-realtime",
      "command": "KLMS_ISOLATED_QA_REQUIRE_CLEAN=1 node tools/run_klms_isolated_state_qa.mjs <isolated-path>",
      "execution": {
        "workingDirectory": ".",
        "environment": {
          "KLMS_ISOLATED_QA_REQUIRE_CLEAN": "1"
        },
        "timeoutSeconds": 1800,
        "maxOutputBytes": 67108864,
        "steps": [
          {"argv": ["node", "tools/run_klms_isolated_state_qa.mjs", "<isolated-path>"]}
        ]
      }
    },
    {
      "id": "mac-payload",
      "command": "OUTPUT_APP=<candidate-app> KLMS_PAYLOAD_REQUIRE_CLEAN=1 tools/build_klms_mac_app.sh",
      "execution": {
        "workingDirectory": ".",
        "environment": {
          "OUTPUT_APP": "<candidate-app>",
          "KLMS_PAYLOAD_REQUIRE_CLEAN": "1"
        },
        "timeoutSeconds": 1800,
        "maxOutputBytes": 67108864,
        "steps": [
          {"argv": ["tools/build_klms_mac_app.sh"]}
        ]
      }
    },
    {
      "id": "ios-simulator-matrix",
      "command": "tools/test_klms_ios_ui_matrix.sh",
      "execution": {
        "workingDirectory": ".",
        "environment": {
          "DERIVED_DATA_PATH": "<isolated-path>",
          "MODULE_CACHE_DIR": "<isolated-module-cache>"
        },
        "timeoutSeconds": 3600,
        "maxOutputBytes": 100663296,
        "steps": [
          {"argv": ["tools/test_klms_ios_ui_matrix.sh"]}
        ]
      }
    },
    {
      "id": "windows-unit",
      "command": "npm test",
      "workingDirectory": "apps/KLMSyncWindows",
      "execution": {
        "workingDirectory": "apps/KLMSyncWindows",
        "environment": {},
        "timeoutSeconds": 600,
        "maxOutputBytes": 16777216,
        "steps": [
          {"argv": ["npm", "test"]}
        ]
      }
    },
    {
      "id": "windows-electron-e2e",
      "command": "npm run test:e2e",
      "workingDirectory": "apps/KLMSyncWindows",
      "execution": {
        "workingDirectory": "apps/KLMSyncWindows",
        "environment": {},
        "timeoutSeconds": 1800,
        "maxOutputBytes": 67108864,
        "steps": [
          {"argv": ["npm", "run", "test:e2e"]}
        ]
      }
    },
    {
      "id": "relay-self-hosted",
      "command": "node --test deploy/relay/test_relay.mjs && node --test deploy/relay/test_restore_db.mjs",
      "execution": {
        "workingDirectory": ".",
        "environment": {},
        "timeoutSeconds": 600,
        "maxOutputBytes": 33554432,
        "steps": [
          {"argv": ["node", "--test", "deploy/relay/test_relay.mjs"]},
          {"argv": ["node", "--test", "deploy/relay/test_restore_db.mjs"]}
        ]
      }
    },
    {
      "id": "relay-cloudflare",
      "command": "npx --yes node@22.23.1 --check src/worker.mjs && npx --yes node@22.23.1 --test test/setup-script.test.mjs && npx --yes node@22.23.1 test/smoke.mjs && npx --yes node@22.23.1 test/integration.mjs",
      "workingDirectory": "deploy/cloudflare-worker",
      "execution": {
        "workingDirectory": "deploy/cloudflare-worker",
        "environment": {},
        "timeoutSeconds": 1800,
        "maxOutputBytes": 67108864,
        "steps": [
          {"argv": ["npx", "--yes", "node@22.23.1", "--check", "src/worker.mjs"]},
          {"argv": ["npx", "--yes", "node@22.23.1", "--test", "test/setup-script.test.mjs"]},
          {"argv": ["npx", "--yes", "node@22.23.1", "test/smoke.mjs"]},
          {"argv": ["npx", "--yes", "node@22.23.1", "test/integration.mjs"]}
        ]
      }
    },
    {
      "id": "security-evidence-apple-common",
      "command": "KLMS_SECURITY_REQUIRE_CLEAN=1 KLMS_SECURITY_SCOPE=apple-common tools/security/run_security_evidence.sh <isolated-path> <scanner-root>",
      "execution": {
        "workingDirectory": ".",
        "environment": {
          "KLMS_SECURITY_REQUIRE_CLEAN": "1",
          "KLMS_SECURITY_SCOPE": "apple-common"
        },
        "timeoutSeconds": 1800,
        "maxOutputBytes": 100663296,
        "steps": [
          {"argv": ["tools/security/run_security_evidence.sh", "<isolated-path>", "<scanner-root>"]}
        ]
      }
    },
    {
      "id": "security-evidence",
      "command": "KLMS_SECURITY_REQUIRE_CLEAN=1 tools/security/run_security_evidence.sh <private-evidence-dir> <scanner-root>",
      "execution": {
        "workingDirectory": ".",
        "environment": {"KLMS_SECURITY_REQUIRE_CLEAN": "1"},
        "timeoutSeconds": 1800,
        "maxOutputBytes": 100663296,
        "steps": [
          {"argv": ["tools/security/run_security_evidence.sh", "<private-evidence-dir>", "<scanner-root>"]}
        ]
      }
    }
  ],
  "independentReviewGates": [
    "goal-and-constraint",
    "code-quality",
    "security-and-privacy",
    "hands-on-runtime",
    "visual-and-accessibility"
  ],
  "releaseEvidenceReceipt": {
    "gateRunner": "tools/run_release_gate.sh <gate-id>",
    "reviewRecorder": "tools/record_release_review.py",
    "generator": "tools/generate_release_evidence_receipt.py",
    "exactCommitRequired": true,
    "cleanWorktreeRequired": true,
    "outputOutsideRepositoryRequired": true,
    "appPayloadSchemaVersion": 2
  },
  "mandatoryExternalEvidence": [
    "physical-iphone-and-ipad-matrix",
    "controlled-impaired-wan-and-reconnect",
    "voiceover-switch-control-and-hardware-keyboard",
    "multi-hour-reconnect-sync-cancel-transfer-soak"
  ]
}
